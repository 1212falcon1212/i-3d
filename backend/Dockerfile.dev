# Geliştirme imajı — air ile hot reload.
# go.mod'daki toolchain sürümüyle aynı olmalı (go 1.25.6).
FROM golang:1.25.6-bookworm

WORKDIR /app

# air'in güncel sürümü Go 1.26 istiyor; imajdaki toolchain 1.25.6 (go.mod ile aynı).
# Sadece bu kurulum için toolchain indirmeye izin veriyoruz — proje derlemesi
# hâlâ imajın kendi 1.25.6'sıyla yapılır.
RUN GOTOOLCHAIN=auto go install github.com/air-verse/air@latest

# Bağımlılıklar imaja önden çekilsin; kaynak bind mount ile gelir.
COPY go.mod go.sum ./
RUN go mod download

EXPOSE 8080
CMD ["air", "-c", ".air.toml"]
